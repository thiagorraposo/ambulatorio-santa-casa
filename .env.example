# Copie para .env e substitua a senha antes de subir o ambiente local.
POSTGRES_DB=ambulatorio_santa_casa
POSTGRES_USER=ambulatorio_user
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_PORT=5433

# Login técnico sem ownership; assume obrigatoriamente ambulatorio_aplicacao.
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=ambulatorio_santa_casa
APP_DB_USER=ambulatorio_backend
APP_DB_PASSWORD=troque_esta_senha_tecnica_local
APP_DB_ROLE=ambulatorio_aplicacao
API_PORT=3000
NODE_ENV=development

# Diretório local ignorado pelo Git para backups lógicos do Docker.
BACKUP_DIR=backups_postgres
